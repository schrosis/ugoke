{
  "name": "ugoke-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ugoke": "node packages/cli/dist/bin.js",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.check.json",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "catalog:",
    "@ugoke/adapter-wait-github": "workspace:*",
    "lefthook": "^2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.23.0"
}
