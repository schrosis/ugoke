fsl 5
// Requirements for the transitions of a workflow definition.
// A definition here has passed the shape check of workflow-definition.fsl; accept and reject are
// the final decision on it. Running an accepted definition is in workflow-run.fsl, and that its
// run always reaches end (REQ-TRN-004) is checked by workflow-pipeline.fsl.
// Source: docs/reference/workflow-definition.md ("ステップのつながり"),
//         packages/core/src/intermediate/validate.ts (validateTransitions).
//
// MODEL-TRN-001: a definition has at most three steps, numbered 0 to 2. Node 3 is end.
// MODEL-TRN-002: next names one node, or branches. A step has at most two targets: to, the last
//                branch or next without branches, and alt, a branch with if. More branches go to
//                these two in the same way. Which branch a run takes is in workflow-run.fsl, and
//                the rules of the branches themselves are in branches.fsl.
// MODEL-TRN-006: a transition can go back to a step on its path, start included, which makes a
//                loop. Every step must still have a path to end (REQ-TRN-003). How often a loop runs
//                is in loops.fsl. A transition to start names the ID of the step, because start is
//                a reserved word, and next: start names an unknown step.
// MODEL-TRN-005: a step that the definition does not have goes to end, and the two targets of a
//                step are written with the smaller one first (to <= alt). Neither changes which
//                definitions the rules accept, and they keep the definitions few enough to check.
// MODEL-TRN-003: a step that next names but the definition does not have is an unknown step.
//
// This file has about 2,500 mutants, and fslc mutate takes about 30 minutes, so it is not
// mutated. Check a change with copies that break it on purpose
// (see .github/scripts/check-specs.sh).
requirements WorkflowTransitions {
  number Node
  number Count
  const END = 3
  actor Author, Ugoke

  entity Definition {
    p0: Bool = false
    p1: Bool = false
    p2: Bool = false
    n0: Node = 3
    n1: Node = 3
    n2: Node = 3
    c0: Node = 3
    c1: Node = 3
    c2: Node = 3
    start: Node = 0
    filled: Count = 0
    lifecycle Draft -> Written -> Accepted
    lifecycle Written -> Rejected
  }

  // A definition is the steps it has (p0 to p2), where each goes next (n0 to n2), and start.

  // These definitions are copies: workflow-transitions.fsl, validate-transitions.fsl and
  // interpret-workflow.fsl each have them, because FSL cannot share a def across files. Keep the
  // three the same.
  def has(p0: Bool, p1: Bool, p2: Bool, x: Node) = (x == 0 and p0) or (x == 1 and p1) or (x == 2 and p2)

  // Where a step goes: to is the last branch, or next without branches, and alt is the branch
  // with if. A step without branches, or whose branches go to one node, has alt equal to to.
  def to(n0: Node, n1: Node, n2: Node, x: Node) =
    if x == 0 then n0 else if x == 1 then n1 else if x == 2 then n2 else END
  def alt(c0: Node, c1: Node, c2: Node, x: Node) =
    if x == 0 then c0 else if x == 1 then c1 else if x == 2 then c2 else END

  // A node that next may name: end, or a step of the definition.
  def known(p0: Bool, p1: Bool, p2: Bool, x: Node) = x == END or has(p0, p1, p2, x)

  // Whether step x of the definition can go to node y.
  def moves(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node, x: Node, y: Node) =
    has(p0, p1, p2, x) and (to(n0, n1, n2, x) == y or alt(c0, c1, c2, x) == y)

  // A step that can go to end or to an unknown step ends a path. An unknown step is reported on
  // its own, so it does not count as a path that never ends.
  def endsPath(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node, x: Node) =
    to(n0, n1, n2, x) == END or alt(c0, c1, c2, x) == END
      or not known(p0, p1, p2, to(n0, n1, n2, x)) or not known(p0, p1, p2, alt(c0, c1, c2, x))

  // Steps from which some path ends within three moves.
  def canEnd(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node, x: Node) =
    has(p0, p1, p2, x) and (
      endsPath(p0, p1, p2, n0, n1, n2, c0, c1, c2, x)
        or (exists y: Node {
          moves(p0, p1, p2, n0, n1, n2, c0, c1, c2, x, y) and has(p0, p1, p2, y) and (
            endsPath(p0, p1, p2, n0, n1, n2, c0, c1, c2, y)
              or (exists z: Node {
                moves(p0, p1, p2, n0, n1, n2, c0, c1, c2, y, z) and has(p0, p1, p2, z) and endsPath(p0, p1, p2, n0, n1, n2, c0, c1, c2, z)
              }))
        })
    )

  // Steps that some path from start visits; three steps need at most two moves.
  def reachable(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node, s: Node, x: Node) =
    x == s or moves(p0, p1, p2, n0, n1, n2, c0, c1, c2, s, x)
      or (exists m: Node { moves(p0, p1, p2, n0, n1, n2, c0, c1, c2, s, m) and moves(p0, p1, p2, n0, n1, n2, c0, c1, c2, m, x) })

  def targetsKnown(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node, s: Node) =
    has(p0, p1, p2, s) and (forall x: Node {
      has(p0, p1, p2, x) => (known(p0, p1, p2, to(n0, n1, n2, x)) and known(p0, p1, p2, alt(c0, c1, c2, x)))
    })

  def allReachable(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node, s: Node) =
    forall x: Node { has(p0, p1, p2, x) => reachable(p0, p1, p2, n0, n1, n2, c0, c1, c2, s, x) }

  def allCanEnd(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node) =
    forall x: Node { has(p0, p1, p2, x) => canEnd(p0, p1, p2, n0, n1, n2, c0, c1, c2, x) }

  // Every rule of the transitions.
  def transitionsOk(p0: Bool, p1: Bool, p2: Bool, n0: Node, n1: Node, n2: Node, c0: Node, c1: Node, c2: Node, s: Node) =
    targetsKnown(p0, p1, p2, n0, n1, n2, c0, c1, c2, s) and allReachable(p0, p1, p2, n0, n1, n2, c0, c1, c2, s) and allCanEnd(p0, p1, p2, n0, n1, n2, c0, c1, c2)

  // The author writes the steps one by one, and then start.
  event fill = Author fills Definition with p: Bool, n: Node, c: Node in Draft
    set p0 = if filled == 0 then input p else p0,
      p1 = if filled == 1 then input p else p1,
      p2 = if filled == 2 then input p else p2,
      n0 = if filled == 0 then input n else n0,
      n1 = if filled == 1 then input n else n1,
      n2 = if filled == 2 then input n else n2,
      c0 = if filled == 0 then input c else c0,
      c1 = if filled == 1 then input c else c1,
      c2 = if filled == 2 then input c else c2,
      filled = filled + 1
    covers REQ-DEF-011 "ワークフローは、YAML のファイルに定義する"
  event write = Author writes Definition with start (Draft -> Written)
    covers REQ-DEF-011 "ワークフローは、YAML のファイルに定義する"
  event accept = Ugoke accepts Definition (Written -> Accepted)
  event reject = Ugoke rejects Definition (Written -> Rejected)

  // MODEL-TRN-004: the author writes the steps one by one and then start, so that each event has
  // few inputs. One event with all of them would make every state try thousands of inputs.
  rule REQ-DEF-011 "ワークフローは、YAML のファイルに定義する" {
    allow Author fills Definition only when filled < 3
      and input n <= input c and (input p or (input n == END and input c == END))
    allow Author writes Definition only when filled == 3
  }
  rule REQ-TRN-001 "start と next が指すステップは、定義になければならない" {
    never Ugoke accepts Definition when not targetsKnown(p0, p1, p2, n0, n1, n2, c0, c1, c2, start)
    AcceptedTargetsKnown: always Definition in Accepted has targetsKnown(p0, p1, p2, n0, n1, n2, c0, c1, c2, start)
  }
  rule REQ-TRN-002 "どのステップも、start からたどれなければならない" {
    never Ugoke accepts Definition when not allReachable(p0, p1, p2, n0, n1, n2, c0, c1, c2, start)
    AcceptedAllReachable: always Definition in Accepted has allReachable(p0, p1, p2, n0, n1, n2, c0, c1, c2, start)
  }
  rule REQ-TRN-003 "どのステップからも、end までたどれなければならない" {
    never Ugoke accepts Definition when not allCanEnd(p0, p1, p2, n0, n1, n2, c0, c1, c2)
    AcceptedAllCanEnd: always Definition in Accepted has allCanEnd(p0, p1, p2, n0, n1, n2, c0, c1, c2)
  }
  rule REQ-TRN-005 "つながりの決まりを満たす定義は受け付ける" {
    allow Ugoke rejects Definition only when not transitionsOk(p0, p1, p2, n0, n1, n2, c0, c1, c2, start)
    RejectedBreaksARule: always Definition in Rejected has not transitionsOk(p0, p1, p2, n0, n1, n2, c0, c1, c2, start)
  }

  scenario AC-TRN-001 "start から next をたどって end に着く定義を受け付ける" {
    Author fills d1 with p true, n 1, c 1
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-002 "3 つのステップを順にたどって end に着く定義を受け付ける" {
    Author fills d1 with p true, n 1, c 1
    Author fills d1 with p true, n 2, c 2
    Author fills d1 with p true, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-003 "最初のステップから始まらない定義を受け付ける" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p true, n 0, c 0
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 1
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-004 "後ろのステップから前へたどる定義を受け付ける" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p true, n 0, c 0
    Author fills d1 with p true, n 1, c 1
    Author writes d1 with start 2
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-005 "間のステップを飛ばしてたどる定義を受け付ける" {
    Author fills d1 with p true, n 2, c 2
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p true, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-006 "最後のステップだけの定義を受け付ける" {
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p true, n 3, c 3
    Author writes d1 with start 2
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-007 "最後のステップから戻ってたどる定義を受け付ける" {
    Author fills d1 with p true, n 2, c 2
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p true, n 1, c 1
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-008 "2 つ目のステップから始まり、前後へたどる定義を受け付ける" {
    Author fills d1 with p true, n 2, c 2
    Author fills d1 with p true, n 0, c 0
    Author fills d1 with p true, n 3, c 3
    Author writes d1 with start 1
    Ugoke accepts d1
    then d1 is Accepted
  }

  scenario AC-TRN-009 "分岐で 2 つのステップに分かれ、同じステップに合流する定義を受け付ける" {
    Author fills d1 with p true, n 1, c 2
    Author fills d1 with p true, n 2, c 2
    Author fills d1 with p true, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-010 "分岐で end に進む定義を受け付ける" {
    Author fills d1 with p true, n 1, c 3
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }

  scenario AC-TRN-011 "end に抜けられるループのある定義を受け付ける" {
    Author fills d1 with p true, n 1, c 1
    Author fills d1 with p true, n 2, c 2
    Author fills d1 with p true, n 1, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }
  scenario AC-TRN-012 "start に戻るループのある定義を受け付ける" {
    Author fills d1 with p true, n 1, c 1
    Author fills d1 with p true, n 0, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then d1 is Accepted
  }
  forbidden FB-TRN-001 "存在しないステップを指す定義を受け付けない" {
    Author fills d1 with p true, n 1, c 1
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then rejected
  }
  forbidden FB-TRN-002 "start からたどれないステップのある定義を受け付けない" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then rejected
  }
  forbidden FB-TRN-005 "決まりを満たす定義を断らない" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke rejects d1
    then rejected
  }
  forbidden FB-TRN-008 "4 つ目のステップは書けない（モデルのステップは 3 つまで）" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    then rejected
  }
  forbidden FB-TRN-009 "ステップを書き終える前に、start を書かない" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    then rejected
  }
  forbidden FB-TRN-010 "start を 2 度書かない" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Author writes d1 with start 0
    then rejected
  }
  forbidden FB-TRN-011 "受け付けた定義を、もう一度受け付けない" {
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    Ugoke accepts d1
    then rejected
  }
  forbidden FB-TRN-014 "分岐で存在しないステップを指す定義を受け付けない" {
    Author fills d1 with p true, n 1, c 2
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then rejected
  }
  forbidden FB-TRN-015 "分岐の先でしかたどれないステップを、たどれないことにしない" {
    Author fills d1 with p true, n 1, c 2
    Author fills d1 with p true, n 3, c 3
    Author fills d1 with p true, n 3, c 3
    Author writes d1 with start 0
    Ugoke rejects d1
    then rejected
  }
  forbidden FB-TRN-018 "end に抜けられないループのある定義を受け付けない" {
    Author fills d1 with p true, n 1, c 1
    Author fills d1 with p true, n 0, c 0
    Author fills d1 with p false, n 3, c 3
    Author writes d1 with start 0
    Ugoke accepts d1
    then rejected
  }
}
verify {
  instances Definition = 1
  values Node = 0..3
  values Count = 0..4
}
