fsl 5
// Requirements for the format of a dotenv file, which script steps, AI steps, and conditions that
// reference env read. Which value a step sees for a name is in script-env.fsl.
// Source: docs/reference/workflow-definition.md ("dotenv のファイル")
//
// MODEL-DOT-001: one line of the file is modeled, with what it is and how its value is written,
//                which are given when the file is read. A value in quotes may span lines, which are
//                one line here. A byte order mark at the start is skipped, and a line may end with
//                LF or CRLF, also inside a value, while a carriage return without a line feed is
//                kept; the last line needs no line break. Whitespace is only spaces and tabs. A
//                name follows the rule of the names of env (script-env.fsl, REQ-ENV-002), after an
//                optional export and blanks. A name that is export, such as in export=value, is the
//                name export.
// MODEL-DOT-002: a value is quoted only when it starts with a quote, after the blanks after =, so
//                the quotes in a value such as a "b" are a part of it; an unquoted value drops the
//                blanks around it, and may be empty, such as in A= or A= # count, and a # after a
//                blank starts a comment; a # without a blank before it is an error, so that a value
//                with # is quoted. A value in single quotes is as written. In double quotes, \n is
//                a line break, and any other backslash is an error; the character after it is still
//                skipped, so that "a\"b" does not end early. After the closing quote, only blanks
//                and a comment may follow, and the comment needs no blank before it, such as in
//                "x"# note. A quote that is never closed stops the reading, and the lines after it
//                are not read. Variables such as $HOME are not expanded.
// MODEL-DOT-003: one file is modeled when a step reads it. Every malformed line is found, and the
//                step fails with the first ten, each with its line number, and the count of the
//                rest. The reasons never contain the name or the value, because a value may be a
//                secret. A name such as __proto__ is an ordinary name.
requirements DotenvFile {
  enum Kind { BlankLine, CommentLine, Assignment, OtherLine }
  enum Form { Unquoted, SingleQuoted, DoubleQuoted, Backquoted }
  actor Worker

  entity Line {
    kind: Kind = BlankLine
    nameOk: Bool = false
    repeated: Bool = false
    form: Form = Unquoted
    hashGlued: Bool = false
    badEscape: Bool = false
    closed: Bool = false
    restOk: Bool = false
    lifecycle Unread -> Scanned -> Kept
    lifecycle Scanned -> Skipped
    lifecycle Scanned -> Bad
  }

  entity File {
    anyBad: Bool = false
    lifecycle Closed -> Opened -> Given
    lifecycle Opened -> Refused
  }

  def valueOk(f: Form, h: Bool, e: Bool, c: Bool, r: Bool) =
    if f == Unquoted then not h
    else if f == SingleQuoted then c and r
    else if f == DoubleQuoted then c and r and not e
    else false
  def lineOk(k: Kind, n: Bool, rep: Bool, f: Form, h: Bool, e: Bool, c: Bool, r: Bool) =
    k == Assignment and n and not rep and valueOk(f, h, e, c, r)

  event scan = Worker scans Line with kind, nameOk, repeated, form, hashGlued, badEscape, closed, restOk (Unread -> Scanned)
    covers REQ-DOT-001 "dotenv のファイルは、1 行に 1 つ、空の行、# のコメント、名前=値 を書く。名前の前に export を付けてもよい"
  event keep = Worker keeps Line (Scanned -> Kept)
  event skip = Worker skips Line (Scanned -> Skipped)
  event mark = Worker marks Line (Scanned -> Bad)
  event open = Worker opens File with anyBad (Closed -> Opened)
    covers REQ-DOT-004 "1 行でも決まりに合わない行があれば、ファイルのどの値も渡さず、ステップは失敗する"
  event give = Worker gives File (Opened -> Given)
  event refuse = Worker refuses File (Opened -> Refused)

  rule REQ-DOT-002 "名前は env と同じ決まりで書き、同じ名前を 2 度は書けない" {
    allow Worker keeps Line only when lineOk(kind, nameOk, repeated, form, hashGlued, badEscape, closed, restOk)
  }
  rule REQ-DOT-003 "値は、引用符なし、一重の引用符で囲む、二重の引用符で囲むのどれかで書く。引用符なしでは、空白のあとの # からがコメント。二重の引用符の中では、バックスラッシュは改行の n の前だけに書ける。閉じた引用符のあとは、空白とコメントだけ。バッククォートで囲んだ値は書けない" {
    allow Worker marks Line only when kind != BlankLine and kind != CommentLine and not lineOk(kind, nameOk, repeated, form, hashGlued, badEscape, closed, restOk)
    allow Worker skips Line only when kind == BlankLine or kind == CommentLine
  }
  rule REQ-DOT-004 "1 行でも決まりに合わない行があれば、ファイルのどの値も渡さず、ステップは失敗する" {
    allow Worker gives File only when not anyBad
    allow Worker refuses File only when anyBad
  }

  scenario AC-DOT-001 "引用符なしの値を読む" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form Unquoted, hashGlued false, badEscape false, closed false, restOk false
    Worker keeps l1
    then l1 is Kept
  }
  scenario AC-DOT-002 "一重の引用符で囲んだ値を読む" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form SingleQuoted, hashGlued false, badEscape false, closed true, restOk true
    Worker keeps l1
    then l1 is Kept
  }
  scenario AC-DOT-003 "コメントの行は、飛ばす" {
    Worker scans l1 with kind CommentLine, nameOk false, repeated false, form Unquoted, hashGlued false, badEscape false, closed false, restOk false
    Worker skips l1
    then l1 is Skipped
  }
  scenario AC-DOT-004 "空白のない # は、決まりに合わない" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form Unquoted, hashGlued true, badEscape false, closed false, restOk false
    Worker marks l1
    then l1 is Bad
  }
  scenario AC-DOT-005 "決まりに合わない行があれば、値を渡さない" {
    Worker opens f1 with anyBad true
    Worker refuses f1
    then f1 is Refused
  }
  scenario AC-DOT-006 "決まりに合う行だけなら、値を渡す" {
    Worker opens f1 with anyBad false
    Worker gives f1
    then f1 is Given
  }

  forbidden FB-DOT-001 "同じ名前を、2 度読まない" {
    Worker scans l1 with kind Assignment, nameOk true, repeated true, form Unquoted, hashGlued false, badEscape false, closed false, restOk false
    Worker keeps l1
    then rejected
  }
  forbidden FB-DOT-002 "二重の引用符の中の、改行でないバックスラッシュを、受け付けない" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form DoubleQuoted, hashGlued false, badEscape true, closed true, restOk true
    Worker keeps l1
    then rejected
  }
  forbidden FB-DOT-003 "閉じない引用符を、受け付けない" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form SingleQuoted, hashGlued false, badEscape false, closed false, restOk true
    Worker keeps l1
    then rejected
  }
  forbidden FB-DOT-004 "閉じた引用符のあとの文字を、受け付けない" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form DoubleQuoted, hashGlued false, badEscape false, closed true, restOk false
    Worker keeps l1
    then rejected
  }
  forbidden FB-DOT-005 "バッククォートで囲んだ値を、受け付けない" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form Backquoted, hashGlued false, badEscape false, closed true, restOk true
    Worker keeps l1
    then rejected
  }
  forbidden FB-DOT-006 "= のない行を、受け付けない" {
    Worker scans l1 with kind OtherLine, nameOk true, repeated false, form Unquoted, hashGlued false, badEscape false, closed false, restOk false
    Worker keeps l1
    then rejected
  }
  forbidden FB-DOT-007 "決まりに合わない行があるのに、値を渡さない" {
    Worker opens f1 with anyBad true
    Worker gives f1
    then rejected
  }
  forbidden FB-DOT-008 "決まりに合う行を、決まりに合わないとしない" {
    Worker scans l1 with kind Assignment, nameOk true, repeated false, form Unquoted, hashGlued false, badEscape false, closed false, restOk false
    Worker marks l1
    then rejected
  }
}
verify {
  instances Line = 1
  instances File = 1
}
