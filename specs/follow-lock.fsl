fsl 5
// Design of the processes that follow one run, and the lock between them
// (packages/cli/src/lock.ts, commands/run.ts, commands/attach.ts, commands/inbox.ts):
//
// - ugoke run starts the run, takes its lock, and runs its steps
// - a process that detaches, or that exits, releases the lock, and the run goes on without one
//   that runs its steps
// - ugoke attach takes the lock of a run that no process follows, and runs its steps when no
//   process runs them
// - ugoke inbox answer --from-ai takes the lock as ugoke attach does, before it answers, and
//   releases it when it exits at the next question or at the end (from-ai.fsl)
// - ugoke cancel ends the run from another process, and the process that follows it then sees the
//   end and releases the lock
//
// - when the resident process runs the steps of the run, no process that follows it runs them,
//   and the run goes on in the resident process after every process detaches. This holds also
//   when the resident process has another ugoke version and the same workflow code version, because
//   it still serves the task queue of the run (packages/cli/src/daemon/connect.ts, pollingQueue)
//
// It is checked against itself.
spec FollowLock {
  entity Process
  entity Run
  enum RunPhase { NotStarted, Going, Over }

  state {
    phase: Map<Run, RunPhase>,
    holds: Map<Process, Bool>,
    stepsIn: Map<Process, Bool>,
    inDaemon: Map<Run, Bool>,
    endedAlone: Map<Run, Bool>
  }

  init {
    forall r: Run {
      phase[r] = NotStarted
      inDaemon[r] = false
      endedAlone[r] = false
    }
    forall p: Process {
      holds[p] = false
      stepsIn[p] = false
    }
  }

  @requirement("MODEL-LCK-001", "ugoke run は、実行を始めてロックを取り、ステップを実行する")
  action start(p: Process, r: Run, d: Bool) {
    requires phase[r] == NotStarted
    phase[r] = Going
    inDaemon[r] = d
    holds[p] = true
    stepsIn[p] = not d
  }

  @requirement("MODEL-LCK-002", "切り離したプロセスはロックを放し、実行はステップを動かすプロセスなしで続く")
  action detach(p: Process, r: Run) {
    requires holds[p] and phase[r] == Going
    holds[p] = false
    stepsIn[p] = false
  }

  @requirement("MODEL-LCK-003", "終わったプロセスのロックは、ほかのプロセスが取り直せる")
  action exit(p: Process) {
    requires holds[p]
    holds[p] = false
    stepsIn[p] = false
  }

  @requirement("REQ-ATT-004", "1 つの実行を追いかけられるのは 1 つのプロセスだけ。ほかのプロセスが追いかけている実行には、attach で戻れない")
  action attach(p: Process, r: Run) {
    requires phase[r] == Going
    requires forall q: Process { not holds[q] }
    holds[p] = true
    stepsIn[p] = not inDaemon[r] and forall q: Process { not stepsIn[q] }
  }

  @requirement("REQ-ATT-006", "attach の終わり方と終了ステータスは、ugoke run と同じ")
  action finish(p: Process, r: Run) {
    requires holds[p] and phase[r] == Going
    requires inDaemon[r] or exists q: Process { stepsIn[q] }
    phase[r] = Over
    holds[p] = false
    stepsIn[p] = false
  }

  @requirement("REQ-DMN-006", "常駐プロセスがステップを実行する実行は、どのプロセスも追いかけていなくても進む")
  action daemonFinish(r: Run) {
    requires phase[r] == Going and inDaemon[r]
    requires forall q: Process { not holds[q] }
    phase[r] = Over
    endedAlone[r] = true
  }

  @requirement("REQ-ATT-007", "cancel は、ほかのプロセスが追いかけている実行も取り消し、終了ステータス 0 で終わる")
  action cancel(p: Process, r: Run) {
    requires phase[r] == Going and not holds[p]
    phase[r] = Over
  }

  @requirement("MODEL-LCK-004", "取り消された実行を追いかけていたプロセスは、終わりを見てロックを放す")
  fair action notice(p: Process, r: Run) {
    requires holds[p] and phase[r] == Over
    holds[p] = false
    stepsIn[p] = false
  }

  @requirement("REQ-ATT-004", "1 つの実行を追いかけられるのは 1 つのプロセスだけ。ほかのプロセスが追いかけている実行には、attach で戻れない")
  invariant OneFollower {
    forall p: Process { forall q: Process { (holds[p] and holds[q]) => p == q } }
  }

  @requirement("MODEL-LCK-001", "ugoke run は、実行を始めてロックを取り、ステップを実行する")
  invariant NoFollowerBeforeStart {
    forall r: Run { forall p: Process { phase[r] == NotStarted => not holds[p] } }
  }

  @requirement("REQ-ATT-005", "実行のステップを動かしているプロセスがなければ、attach がステップを実行する")
  invariant StepsOnlyInFollower {
    forall p: Process { stepsIn[p] => holds[p] }
  }

  @requirement("REQ-ATT-005", "実行のステップを動かしているプロセスがなければ、attach がステップを実行する")
  invariant FollowedRunHasSteps {
    forall r: Run { forall p: Process { (holds[p] and phase[r] == Going) => (inDaemon[r] or exists q: Process { stepsIn[q] }) } }
  }

  @requirement("REQ-DMN-006", "常駐プロセスがステップを実行する実行は、どのプロセスも追いかけていなくても進む")
  invariant StepsInOnePlace {
    forall r: Run { inDaemon[r] => forall p: Process { not stepsIn[p] } }
  }

  @requirement("MODEL-LCK-001", "ugoke run は、実行を始めてロックを取り、ステップを実行する")
  invariant NoDaemonBeforeStart {
    forall r: Run { phase[r] == NotStarted => not inDaemon[r] }
  }

  @requirement("REQ-DMN-006", "常駐プロセスがステップを実行する実行は、どのプロセスも追いかけていなくても進む")
  reachable DetachedRunEndsInDaemon {
    exists r: Run { endedAlone[r] }
  }

  @requirement("MODEL-LCK-004", "取り消された実行を追いかけていたプロセスは、終わりを見てロックを放す")
  leadsTo FollowerSeesTheEnd {
    (exists p: Process { holds[p] } and forall r: Run { phase[r] == Over }) ~> forall p: Process { not holds[p] }
  }

  terminal { forall r: Run { phase[r] != Going } and forall p: Process { not holds[p] } }
}
verify {
  instances Process = 2
  instances Run = 1
}
