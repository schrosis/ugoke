fsl 5
// Requirements for ugoke docs: it writes a Markdown document of each workflow next to its
// definition, and never replaces a file that it did not write.
// Source: docs/reference/commands/docs.md. The shape of the diagram and the marker line are kept
// here only, and not in the docs.
//
// MODEL-DOC-001: one workflow is modeled. Whether its name can be a workflow name, whether its
//                definition passes the checks, and whether a file is already where the document
//                goes, and whether that file starts with the marker line of ugoke docs, are given
//                when the command comes to it. Whether another workflow of the same command
//                failed is given too, which decides the exit status with this one. named tells
//                whether the command names the workflow. definitionOk is false also when the
//                definition file cannot be found, when both .yaml and .yml exist, and when the
//                document cannot be read or written, which each fail the workflow in the same way.
//                A document that ugoke docs wrote and someone edited still starts with the marker
//                line, so it is Generated, and the next run replaces it.
// MODEL-DOC-002: the document starts with the marker line
//                "<!-- Generated by ugoke docs. Do not edit. -->", which tells it from a file that
//                someone wrote, and holds one Mermaid flowchart. The
//                flowchart has a start and an end circle, a box for each script step, a rounded
//                box for each AI step, and a hexagon for each wait step. A condition of a branch is
//                a rhombus, written without ${{ }}, with a line for each part that && and || join
//                outside of parentheses and strings. A step goes to its first condition, each
//                condition goes to its target with yes and to the next condition with no, and the
//                last condition goes with no to the target of the branch without if, so a list
//                with only the branch without if goes straight to its target. The steps are drawn
//                in the order of the definition with their IDs as labels. A condition is on one
//                line and never shortened, and only ", <, and > are written as entities.
// MODEL-DOC-003: without a name, the workflows are taken in order of their names, and a project
//                without .ugoke/workflows has none, which ends with 0. A directory outside of a
//                project ends with 1, and so does a problem in the configuration file of the
//                project (project-config.fsl), before any document is written.
requirements DocsCommand {
  enum Existing { NoFile, Generated, Foreign }
  enum Exit { Pending, Zero, One }
  actor User, Ugoke

  entity Document {
    named: Bool = false
    nameOk: Bool = false
    definitionOk: Bool = false
    existing: Existing = NoFile
    othersFailed: Bool = false
    exitCode: Exit = Pending
    lifecycle Unvisited -> Visited -> Written
    lifecycle Visited -> Skipped
    lifecycle Visited -> Refused
    lifecycle Visited -> Kept
  }

  def exitOf(failed: Bool) = if failed then One else Zero

  event visit = User asks Document with named, nameOk, definitionOk, existing, othersFailed (Unvisited -> Visited)
    covers REQ-DOC-001 "ugoke docs は、ワークフローのつながりを図にした Markdown の文書を、定義の隣に、同じ名前で拡張子を .md にして作る"
  event write = Ugoke writes Document (Visited -> Written)
    set exitCode = exitOf(othersFailed)
  event skip = Ugoke skips Document (Visited -> Skipped)
    set exitCode = exitOf(othersFailed)
  event refuse = Ugoke refuses Document (Visited -> Refused)
    set exitCode = One
  event keep = Ugoke keeps Document (Visited -> Kept)
    set exitCode = One

  rule REQ-DOC-002 "名前を書かずに全部作るとき、ワークフローの名前にできないファイルは、そのことを表示して飛ばす" {
    allow Ugoke skips Document only when not named and not nameOk
  }
  rule REQ-DOC-003 "定義に問題があるワークフローと、指定した名前が名前にできないときは、エラーを表示し、文書を作らない" {
    allow Ugoke refuses Document only when (named and not nameOk) or (nameOk and not definitionOk)
  }
  rule REQ-DOC-004 "ugoke docs が作ったのではないファイルは、書き換えない。ugoke docs が作った文書は、作り直す" {
    allow Ugoke keeps Document only when nameOk and definitionOk and existing == Foreign
    allow Ugoke writes Document only when nameOk and definitionOk and existing != Foreign
  }
  rule REQ-DOC-005 "1 つでも作れなかった文書があれば、終了ステータス 1。ほかのワークフローは続ける" {
    NotWrittenExitsOne: always Document in Refused, Kept has exitCode == One
    OthersDecideTheRest: always Document in Written, Skipped has exitCode == exitOf(othersFailed)
  }

  scenario AC-DOC-001 "文書のないワークフローの文書を作る" {
    User asks d1 with named false, nameOk true, definitionOk true, existing NoFile, othersFailed false
    Ugoke writes d1
    then stage(d1) == Written and d1.exitCode == Zero
  }
  scenario AC-DOC-002 "ugoke docs が作った文書は、作り直す" {
    User asks d1 with named false, nameOk true, definitionOk true, existing Generated, othersFailed false
    Ugoke writes d1
    then d1 is Written
  }
  scenario AC-DOC-003 "ugoke docs が作ったのではないファイルは、書き換えずに 1 で終わる" {
    User asks d1 with named false, nameOk true, definitionOk true, existing Foreign, othersFailed false
    Ugoke keeps d1
    then stage(d1) == Kept and d1.exitCode == One
  }
  scenario AC-DOC-004 "定義に問題があれば、文書を作らずに 1 で終わる" {
    User asks d1 with named false, nameOk true, definitionOk false, existing NoFile, othersFailed false
    Ugoke refuses d1
    then stage(d1) == Refused and d1.exitCode == One
  }
  scenario AC-DOC-005 "ほかのワークフローが失敗すれば、作れても 1 で終わる" {
    User asks d1 with named false, nameOk true, definitionOk true, existing NoFile, othersFailed true
    Ugoke writes d1
    then stage(d1) == Written and d1.exitCode == One
  }
  scenario AC-DOC-006 "名前にできないファイルは、飛ばす" {
    User asks d1 with named false, nameOk false, definitionOk true, existing NoFile, othersFailed false
    Ugoke skips d1
    then stage(d1) == Skipped and d1.exitCode == Zero
  }

  scenario AC-DOC-007 "指定した名前が名前にできなければ、飛ばさずに 1 で終わる" {
    User asks d1 with named true, nameOk false, definitionOk false, existing NoFile, othersFailed false
    Ugoke refuses d1
    then stage(d1) == Refused and d1.exitCode == One
  }
  forbidden FB-DOC-006 "指定した名前が名前にできないのに、飛ばさない" {
    User asks d1 with named true, nameOk false, definitionOk false, existing NoFile, othersFailed false
    Ugoke skips d1
    then rejected
  }
  forbidden FB-DOC-001 "ugoke docs が作ったのではないファイルを、書き換えない" {
    User asks d1 with named false, nameOk true, definitionOk true, existing Foreign, othersFailed false
    Ugoke writes d1
    then rejected
  }
  forbidden FB-DOC-002 "定義に問題があるのに、文書を作らない" {
    User asks d1 with named false, nameOk true, definitionOk false, existing NoFile, othersFailed false
    Ugoke writes d1
    then rejected
  }
  forbidden FB-DOC-003 "ugoke docs が作った文書を、残さない" {
    User asks d1 with named false, nameOk true, definitionOk true, existing Generated, othersFailed false
    Ugoke keeps d1
    then rejected
  }
  forbidden FB-DOC-004 "名前にできるワークフローを、飛ばさない" {
    User asks d1 with named false, nameOk true, definitionOk true, existing NoFile, othersFailed false
    Ugoke skips d1
    then rejected
  }
  forbidden FB-DOC-005 "名前にできないファイルを、定義の問題にしない" {
    User asks d1 with named false, nameOk false, definitionOk false, existing NoFile, othersFailed false
    Ugoke refuses d1
    then rejected
  }
}
verify {
  instances Document = 1
}
